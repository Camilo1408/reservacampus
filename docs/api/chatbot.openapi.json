{
  "openapi": "3.1.0",
  "info": {
    "title": "Chatbot Service · ReservaCampus",
    "description": "Asistente virtual híbrido: motor de reglas determinista + IA (Groq) como respaldo.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "sistema"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Chat",
        "operationId": "chat_chat_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatIn": {
        "properties": {
          "mensaje": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Mensaje"
          },
          "historial": {
            "items": {
              "$ref": "#/components/schemas/MensajeHistorial"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Historial"
          }
        },
        "type": "object",
        "required": [
          "mensaje"
        ],
        "title": "ChatIn"
      },
      "ChatOut": {
        "properties": {
          "respuesta": {
            "type": "string",
            "title": "Respuesta"
          },
          "fuente": {
            "type": "string",
            "enum": [
              "reglas",
              "ia",
              "respaldo"
            ],
            "title": "Fuente"
          },
          "intencion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intencion"
          },
          "sugerencias": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sugerencias",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "respuesta",
          "fuente"
        ],
        "title": "ChatOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MensajeHistorial": {
        "properties": {
          "rol": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Rol"
          },
          "texto": {
            "type": "string",
            "maxLength": 2000,
            "title": "Texto"
          }
        },
        "type": "object",
        "required": [
          "rol",
          "texto"
        ],
        "title": "MensajeHistorial"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}